  updatedAt                   DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  activationTokensCreatedBy   ActivationToken[]       @relation("activation_tokens_created_byTousers")
  activationTokens            ActivationToken[]       @relation("activation_tokens_user_idTousers")
  analysisRuns                AnalysisRun[]
  analystCandidates           AnalystCandidate[]
  assessmentCorrections       AssessmentCorrection[]
  assessmentRuns              AssessmentRun[]
  auditEvents                 AuditEvent[]
  bpmnMappings                BpmnMapping[]
  bpmnModelsApprovedBy        BpmnModel[]             @relation("bpmn_models_approved_byTousers")
  bpmnModelsCreatedBy         BpmnModel[]             @relation("bpmn_models_created_byTousers")
  calendarsApprovedBy         Calendar[]              @relation("calendars_approved_byTousers")
  calendarsCreatedBy          Calendar[]              @relation("calendars_created_byTousers")
  calendarsReviewedBy         Calendar[]              @relation("calendars_reviewed_byTousers")
  candidateComparisons        CandidateComparison[]
  candidateSets               CandidateSet[]
  contextDocuments            ContextDocument[]
  contextPackagesActivatedBy  ContextPackage[]        @relation("context_packages_activated_byTousers")
  contextPackagesCreatedBy    ContextPackage[]        @relation("context_packages_created_byTousers")
  datasetVersionsCreatedBy    DatasetVersion[]        @relation("dataset_versions_created_byTousers")
  datasetVersionsPublishedBy  DatasetVersion[]        @relation("dataset_versions_published_byTousers")
  evaluationRuns              EvaluationRun[]
  evidenceBundles             EvidenceBundle[]
  hypothesesApprovedBy        Hypothesis[]            @relation("hypotheses_approved_byTousers")
  hypothesesCreatedBy         Hypothesis[]            @relation("hypotheses_created_byTousers")
  hypothesesReviewedBy        Hypothesis[]            @relation("hypotheses_reviewed_byTousers")
  interpretationVersions      InterpretationVersion[]
  interpretationsAcceptedBy   Interpretation[]        @relation("interpretations_accepted_byTousers")
  interpretationsFlaggedBy    Interpretation[]        @relation("interpretations_flagged_byTousers")
  interpretationsRequestedBy  Interpretation[]        @relation("interpretations_requested_byTousers")
  interventionsApprovedBy     Intervention[]          @relation("interventions_approved_byTousers")
  interventionsCreatedBy      Intervention[]          @relation("interventions_created_byTousers")
  interventionsReviewedBy     Intervention[]          @relation("interventions_reviewed_byTousers")
  mappingVersions             MappingVersion[]
  membershipsAddedBy          Membership[]            @relation("memberships_added_byTousers")
  memberships                 Membership[]            @relation("memberships_user_idTousers")
  monitoringConfigs           MonitoringConfig[]
  priorityPolicies            PriorityPolicy[]
  processBoundariesApprovedBy ProcessBoundary[]       @relation("process_boundaries_approved_byTousers")
  processBoundariesCreatedBy  ProcessBoundary[]       @relation("process_boundaries_created_byTousers")
  processBoundariesReviewedBy ProcessBoundary[]       @relation("process_boundaries_reviewed_byTousers")
  promptTemplates             PromptTemplate[]
  questionSpecs               QuestionSpec[]
  reworkDefinitionsApprovedBy ReworkDefinition[]      @relation("rework_definitions_approved_byTousers")
  reworkDefinitionsCreatedBy  ReworkDefinition[]      @relation("rework_definitions_created_byTousers")
  reworkDefinitionsReviewedBy ReworkDefinition[]      @relation("rework_definitions_reviewed_byTousers")
  rubricsApprovedBy           Rubric[]                @relation("rubrics_approved_byTousers")
  rubricsCreatedBy            Rubric[]                @relation("rubrics_created_byTousers")
  rubricsReviewedBy           Rubric[]                @relation("rubrics_reviewed_byTousers")
  rulesApprovedBy             Rule[]                  @relation("rules_approved_byTousers")
  rulesCreatedBy              Rule[]                  @relation("rules_created_byTousers")
  rulesReviewedBy             Rule[]                  @relation("rules_reviewed_byTousers")
  sessions                    Session[]
  sourceSnapshots             SourceSnapshot[]
  sources                     Source[]

  @@map("users")
}

model ValidationCheck {
  validationId  String              @map("validation_id") @db.Uuid
  checkKey      String              @map("check_key")
  status        String
  failureStatus String?             @map("failure_status")
  reason        String
  details       Json                @default("{}")
  validation    CandidateValidation @relation(fields: [validationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([validationId, checkKey])
  @@map("validation_checks")
}

model Variant {
  runId           String      @map("run_id") @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  rank            Int
  sequenceHash    String      @map("sequence_hash")
  sequence        Json
  caseCount       BigInt      @map("case_count")
  share           Float
  cumulativeShare Float       @map("cumulative_share")
  medianDurationS Float       @map("median_duration_s")
  project         Project     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run             AnalysisRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([runId, sequenceHash])
  @@map("variants")
}

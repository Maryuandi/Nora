generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model ActivationToken {
  tokenHash     String    @id @map("token_hash")
  userId        String    @map("user_id") @db.Uuid
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdByUser User?     @relation("activation_tokens_created_byTousers", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User      @relation("activation_tokens_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("activation_tokens")
}

model AnalysisCaseEdge {
  runId        String      @map("run_id") @db.Uuid
  caseUid      String      @map("case_uid")
  fromActivity String      @map("from_activity")
  toActivity   String      @map("to_activity")
  occurrences  Int
  totalWaitS   Float       @map("total_wait_s")
  maxWaitS     Float       @map("max_wait_s")
  run          AnalysisRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([runId, fromActivity, toActivity, caseUid])
  @@map("analysis_case_edges")
}

model AnalysisCaseNode {
  runId       String      @map("run_id") @db.Uuid
  caseUid     String      @map("case_uid")
  activity    String
  occurrences Int
  run         AnalysisRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([runId, activity, caseUid])
  @@map("analysis_case_nodes")
}

model AnalysisCase {
  runId         String      @map("run_id") @db.Uuid
  projectId     String      @map("project_id") @db.Uuid
  caseUid       String      @map("case_uid")
  caseId        String      @map("case_id")
  startTime     DateTime?   @map("start_time") @db.Timestamptz(6)
  endTime       DateTime?   @map("end_time") @db.Timestamptz(6)
  durationS     Float?      @map("duration_s")
  eventCount    Int         @map("event_count")
  firstActivity String?     @map("first_activity")
  lastActivity  String?     @map("last_activity")
  variantHash   String      @map("variant_hash")
  rowStart      BigInt      @map("row_start")
  rowEnd        BigInt      @map("row_end")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run           AnalysisRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([runId, caseUid])
  @@map("analysis_cases")
}

model AnalysisMetricSeries {
  runId           String      @map("run_id") @db.Uuid
  bucket          DateTime    @db.Date
  started         Int
  completed       Int?
  medianDurationS Float?      @map("median_duration_s")
  run             AnalysisRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([runId, bucket])
  @@map("analysis_metric_series")
}

model AnalysisMetric {
  runId            String           @map("run_id") @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  metricKey        String           @map("metric_key")
  metricVersion    Int              @map("metric_version")
  value            Float?
  unit             String
  available        Boolean
  reason           String?
  smallSample      Boolean          @map("small_sample")
  population       Json
  metricDefinition MetricDefinition @relation(fields: [metricKey, metricVersion], references: [key, version], onDelete: NoAction, onUpdate: NoAction)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run              AnalysisRun      @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([runId, metricKey])
  @@map("analysis_metrics")
}

model AnalysisRun {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId               String                 @map("project_id") @db.Uuid
  datasetVersionId        String                 @map("dataset_version_id") @db.Uuid
  contextPackageId        String                 @map("context_package_id") @db.Uuid
  type                    String                 @default("process")
  filterSpec              Json                   @map("filter_spec")
  algorithmVersion        String                 @map("algorithm_version")
  analysisKey             String                 @map("analysis_key")
  status                  String                 @default("queued")
  artifactPrefix          String                 @map("artifact_prefix")
  requestedBy             String?                @map("requested_by") @db.Uuid
  errorMessage            String?                @map("error_message")
  coverage                Json?
  warnings                Json                   @default("[]")
  projectStatusChanged    Boolean                @default(false) @map("project_status_changed")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt               DateTime?              @map("started_at") @db.Timestamptz(6)
  resultReadyAt           DateTime?              @map("result_ready_at") @db.Timestamptz(6)
  completedAt             DateTime?              @map("completed_at") @db.Timestamptz(6)
  monitoringConfigId      String?                @map("monitoring_config_id") @db.Uuid
  monitoringConfig        Json?                  @map("monitoring_config")
  monitoringStatus        String                 @default("pending") @map("monitoring_status")
  monitoringError         String?                @map("monitoring_error")
  analysisCaseEdges       AnalysisCaseEdge[]
  analysisCaseNodes       AnalysisCaseNode[]
  analysisCases           AnalysisCase[]
  analysisMetricSeries    AnalysisMetricSeries[]
  analysisMetrics         AnalysisMetric[]
  contextPackage          ContextPackage         @relation(fields: [contextPackageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  datasetVersion          DatasetVersion         @relation(fields: [datasetVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  monitoringConfigVersion MonitoringConfig?      @relation(fields: [monitoringConfigId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project                 Project                @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser         User?                  @relation(fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conformanceResult       ConformanceResult?
  findings                Finding[]
  processEdges            ProcessEdge[]
  processNodes            ProcessNode[]
  reworkResult            ReworkResult?
  ruleEvaluations         RuleEvaluation[]
  transitionMetrics       TransitionMetric[]
  variants                Variant[]

  @@index([projectId, analysisKey], map: "analysis_runs_key_idx")
  @@index([projectId, createdAt(sort: Desc)], map: "analysis_runs_project_idx")
  @@map("analysis_runs")
}

model AnalystCandidate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  findingId        String   @map("finding_id") @db.Uuid
  version          Int      @default(1)
  payload          Json
  addressedProblem String   @map("addressed_problem")
  sourceReason     String   @map("source_reason")
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUser    User?    @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finding          Finding  @relation(fields: [findingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("analyst_candidates")
}

model AssessmentCorrection {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  assessmentId  String        @map("assessment_id") @db.Uuid
  kind          String
  conclusion    String?
  criteria      Json?
  reason        String
  goldCandidate Boolean       @default(false) @map("gold_candidate")
  createdBy     String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  assessment    Assessment    @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser User?         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  goldSetItems  GoldSetItem[]

  @@map("assessment_corrections")
}

model AssessmentCriterionResult {
  assessmentId String     @map("assessment_id") @db.Uuid
  criterionKey String     @map("criterion_key")
  weight       Float
  score        Int?
  normalized   Float?
  probability  Float?
  distribution Json?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([assessmentId, criterionKey])
  @@map("assessment_criterion_results")
}

model AssessmentRun {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  findingId        String          @map("finding_id") @db.Uuid
  trigger          String
  requestedBy      String?         @map("requested_by") @db.Uuid
  status           String          @default("queued")
  evidenceBundleId String?         @map("evidence_bundle_id") @db.Uuid
  errorMessage     String?         @map("error_message")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  evidenceBundle   EvidenceBundle? @relation(fields: [evidenceBundleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finding          Finding         @relation(fields: [findingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project          Project         @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser  User?           @relation(fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments      Assessment[]

  @@map("assessment_runs")
}

model Assessment {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                  String                      @map("project_id") @db.Uuid
  assessmentRunId            String                      @map("assessment_run_id") @db.Uuid
  findingId                  String                      @map("finding_id") @db.Uuid
  candidateLinkId            String                      @map("candidate_link_id") @db.Uuid
  evidenceBundleId           String?                     @map("evidence_bundle_id") @db.Uuid
  questionSpecs              Json                        @map("question_specs")
  rubricId                   String?                     @map("rubric_id") @db.Uuid
  rubricVersion              Int?                        @map("rubric_version")
  adapter                    String
  model                      String?
  modelVersion               String?                     @map("model_version")
  idempotencyKey             String                      @map("idempotency_key")
  status                     String                      @default("queued")
  sufficiencyProbability     Float?                      @map("sufficiency_probability")
  conclusion                 String?
  distribution               Json?
  topProbability             Float?                      @map("top_probability")
  margin                     Float?
  totalScore                 Float?                      @map("total_score")
  missingCriteria            Json                        @default("[]") @map("missing_criteria")
  contextMaybeStale          Boolean                     @default(false) @map("context_maybe_stale")
  contextLimited             Boolean                     @default(false) @map("context_limited")
  errorMessage               String?                     @map("error_message")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt                DateTime?                   @map("completed_at") @db.Timestamptz(6)
  assessmentCorrections      AssessmentCorrection[]
  assessmentCriterionResults AssessmentCriterionResult[]
  assessmentRun              AssessmentRun               @relation(fields: [assessmentRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidateLink              CandidateLink               @relation(fields: [candidateLinkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evidenceBundle             EvidenceBundle?             @relation(fields: [evidenceBundleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finding                    Finding                     @relation(fields: [findingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project                    Project                     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rubric                     Rubric?                     @relation(fields: [rubricId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidateValidations       CandidateValidation[]
  goldSetItem                GoldSetItem?

  @@index([projectId, findingId, createdAt(sort: Desc)], map: "assessments_finding_idx")
  @@index([projectId, idempotencyKey], map: "assessments_key_idx")
  @@map("assessments")
}

model AuditEvent {
  id            BigInt   @id @default(autoincrement())
  projectId     String?  @map("project_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  objectType    String   @map("object_type")
  objectId      String?  @map("object_id")
  result        String
  correlationId String   @map("correlation_id")
  metadataJson  Json     @default("{}") @map("metadata_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId, createdAt(sort: Desc)], map: "audit_events_project_idx")
  @@map("audit_events")
}

model BpmnMapping {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String              @map("project_id") @db.Uuid
  bpmnModelId          String              @map("bpmn_model_id") @db.Uuid
  version              Int
  mapping              Json
  labelSourceDatasetId String?             @map("label_source_dataset_id") @db.Uuid
  conflicts            Json                @default("[]")
  unmappedTasks        Json                @default("[]") @map("unmapped_tasks")
  unmappedActivities   Json                @default("[]") @map("unmapped_activities")
  createdBy            String?             @map("created_by") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  bpmnModel            BpmnModel           @relation(fields: [bpmnModelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser        User?               @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labelSourceDataset   DatasetVersion?     @relation(fields: [labelSourceDatasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project              Project             @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conformanceResults   ConformanceResult[]
  contextPackages      ContextPackage[]

  @@unique([bpmnModelId, version])
  @@map("bpmn_mappings")
}

model BpmnModel {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String              @map("project_id") @db.Uuid
  itemKey            String              @map("item_key")
  version            Int
  name               String
  fileName           String              @map("file_name")
  objectKey          String              @map("object_key")
  sha256             String
  status             String              @default("draft")
  validationStatus   String              @default("pending") @map("validation_status")
  readable           Boolean             @default(false)
  validationError    String?             @map("validation_error")
  tasks              Json                @default("[]")
  elementCount       Int?                @map("element_count")
  pm4pySummary       Json?               @map("pm4py_summary")
  sourceDocumentId   String?             @map("source_document_id") @db.Uuid
  sourceReference    String              @default("") @map("source_reference")
  createdBy          String?             @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedBy         String?             @map("approved_by") @db.Uuid
  approvedAt         DateTime?           @map("approved_at") @db.Timestamptz(6)
  bpmnMappings       BpmnMapping[]
  approvedByUser     User?               @relation("bpmn_models_approved_byTousers", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser      User?               @relation("bpmn_models_created_byTousers", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceDocument     ContextDocument?    @relation(fields: [sourceDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conformanceResults ConformanceResult[]
  contextPackages    ContextPackage[]

  @@unique([projectId, itemKey, version])
  @@map("bpmn_models")
}

model Calendar {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  itemKey          String           @map("item_key")
  version          Int
  status           String           @default("draft")
  payload          Json
  sourceDocumentId String?          @map("source_document_id") @db.Uuid
  sourceReference  String           @default("") @map("source_reference")
  createdBy        String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedBy       String?          @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  approvedBy       String?          @map("approved_by") @db.Uuid
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  approvedByUser   User?            @relation("calendars_approved_byTousers", fields: [approvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser    User?            @relation("calendars_created_byTousers", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedByUser   User?            @relation("calendars_reviewed_byTousers", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceDocument   ContextDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contextPackages  ContextPackage[]

  @@unique([projectId, itemKey, version])
  @@index([projectId, status], map: "calendars_project_idx")
  @@map("calendars")
}

model CandidateComparison {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  findingId        String   @map("finding_id") @db.Uuid
  hash             String
  candidateLinkIds String[] @map("candidate_link_ids") @db.Uuid
  validationIds    String[] @map("validation_ids") @db.Uuid
  assessmentIds    String[] @map("assessment_ids") @db.Uuid
  scoreIds         String[] @map("score_ids") @db.Uuid
  bundleIds        String[] @map("bundle_ids") @db.Uuid
  payload          Json
  requestedBy      String?  @map("requested_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  finding          Finding  @relation(fields: [findingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser  User?    @relation(fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, hash])
  @@map("candidate_comparisons")
}

model CandidateLink {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String                @map("project_id") @db.Uuid
  findingId            String                @map("finding_id") @db.Uuid
  contextPackageId     String                @map("context_package_id") @db.Uuid
  candidateType        String                @map("candidate_type")
  candidateId          String                @map("candidate_id") @db.Uuid
  candidateKey         String                @map("candidate_key")
  candidateVersion     Int                   @map("candidate_version")
  origin               String
  preconditionStatus   String                @map("precondition_status")
  preconditionChecks   Json                  @map("precondition_checks")
  latestStatus         String?               @map("latest_status")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  assessments          Assessment[]
  contextPackage       ContextPackage        @relation(fields: [contextPackageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finding              Finding               @relation(fields: [findingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidateValidations CandidateValidation[]

  @@unique([findingId, candidateId])
  @@index([projectId, findingId], map: "candidate_links_finding_idx")
  @@map("candidate_links")
}

model CandidateScore {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  validationId  String              @map("validation_id") @db.Uuid
  policyId      String?             @map("policy_id") @db.Uuid
  policyVersion Int                 @map("policy_version")
  weights       Json
  components    Json
  missing       Json
  partial       Boolean
  score         Float?
  rank          Int?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  policy        PriorityPolicy?     @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validation    CandidateValidation @relation(fields: [validationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([validationId, createdAt(sort: Desc)], map: "candidate_scores_validation_idx")
  @@map("candidate_scores")
}

model CandidateSet {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String                @map("project_id") @db.Uuid
  findingId            String                @map("finding_id") @db.Uuid
  contextPackageId     String                @map("context_package_id") @db.Uuid
  status               String                @default("queued")
  requestedBy          String?               @map("requested_by") @db.Uuid
  errorMessage         String?               @map("error_message")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt          DateTime?             @map("completed_at") @db.Timestamptz(6)
  contextPackage       ContextPackage        @relation(fields: [contextPackageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finding              Finding               @relation(fields: [findingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedByUser      User?                 @relation(fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidateValidations CandidateValidation[]

  @@index([projectId, findingId, createdAt(sort: Desc)], map: "candidate_sets_finding_idx")
  @@map("candidate_sets")
}

model CandidateValidation {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  candidateSetId   String            @map("candidate_set_id") @db.Uuid
  candidateLinkId  String            @map("candidate_link_id") @db.Uuid
  status           String
  datasetVersionId String            @map("dataset_version_id") @db.Uuid
  contextPackageId String            @map("context_package_id") @db.Uuid
  assessmentId     String?           @map("assessment_id") @db.Uuid
  evidenceBundleId String?           @map("evidence_bundle_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  candidateScores  CandidateScore[]
  assessment       Assessment?       @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidateLink    CandidateLink     @relation(fields: [candidateLinkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidateSet     CandidateSet      @relation(fields: [candidateSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contextPackage   ContextPackage    @relation(fields: [contextPackageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  datasetVersion   DatasetVersion    @relation(fields: [datasetVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evidenceBundle   EvidenceBundle?   @relation(fields: [evidenceBundleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validationChecks ValidationCheck[]

  @@index([candidateLinkId, createdAt(sort: Desc)], map: "candidate_validations_link_idx")
  @@map("candidate_validations")
}

model CapabilityMatrix {
  datasetVersionId String         @id @map("dataset_version_id") @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  capabilities     Json
  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

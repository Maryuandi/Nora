{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "analysisRunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "eventsKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "artifactPrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "filter": {
      "type": "object",
      "properties": {
        "version": {
          "default": 1,
          "type": "number",
          "const": 1
        },
        "period": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "attribute": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "values": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              },
              "required": [
                "key",
                "values"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "activityPresent": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "activityAbsent": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "variants": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{16,64}$"
          }
        },
        "duration": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "minSeconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxSeconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "completion": {
          "default": "all",
          "type": "string",
          "enum": [
            "all",
            "complete",
            "incomplete"
          ]
        },
        "objectRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "activityPresent",
        "activityAbsent",
        "variants",
        "completion"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "startActivities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "endActivities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "startActivities",
            "endActivities"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rework": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rules": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "repeated_activity"
                      },
                      "activity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "minOccurrences": {
                        "default": 2,
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 50
                      }
                    },
                    "required": [
                      "type",
                      "activity",
                      "minOccurrences"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "return_transition"
                      },
                      "from": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "to": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "type",
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "semantic_category"
                      },
                      "category": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "type",
                      "category"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "sequence_pattern"
                      },
                      "sequence": {
                        "minItems": 2,
                        "maxItems": 10,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    },
                    "required": [
                      "type",
                      "sequence"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "key": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "payload": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "params": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "sla_duration"
                      },
                      "fromActivity": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "toActivity": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "maxHours": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 100000
                      }
                    },
                    "required": [
                      "type",
                      "maxHours"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ordering"
                      },
                      "before": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "after": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "type",
                      "before",
                      "after"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "required_activity"
                      },
                      "activity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "type",
                      "activity"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "forbidden_activity"
                      },
                      "activity": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "type",
                      "activity"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "separation_of_duties"
                      },
                      "activityA": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "activityB": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "type",
                      "activityA",
                      "activityB"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "scope": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "effectiveFrom": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effectiveTo": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "params",
              "scope"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "key",
          "version",
          "payload"
        ],
        "additionalProperties": false
      }
    },
    "bpmn": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "objectKey": {
              "type": "string"
            },
            "modelId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "mappingId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "mappingVersion": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "mapping": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "objectKey",
            "modelId",
            "mappingId",
            "mappingVersion",
            "tasks",
            "mapping"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "bpmnUnavailableReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "bottleneck": {
          "default": {
            "topK": 5,
            "minP90Seconds": 86400,
            "minSupportCases": 10
          },
          "type": "object",
          "properties": {
            "topK": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "minP90Seconds": {
              "default": 86400,
              "type": "number",
              "minimum": 0
            },
            "minSupportCases": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "topK",
            "minP90Seconds",
            "minSupportCases"
          ],
          "additionalProperties": false
        },
        "rework": {
          "default": {
            "minCaseShare": 0.1,
            "minSupportCases": 10
          },
          "type": "object",
          "properties": {
            "minCaseShare": {
              "default": 0.1,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minSupportCases": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "minCaseShare",
            "minSupportCases"
          ],
          "additionalProperties": false
        },
        "rules": {
          "default": {
            "minNonCompliantShare": 0.05,
            "minSupportCases": 5
          },
          "type": "object",
          "properties": {
            "minNonCompliantShare": {
              "default": 0.05,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minSupportCases": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "minNonCompliantShare",
            "minSupportCases"
          ],
          "additionalProperties": false
        },
        "conformance": {
          "default": {
            "minFitness": 0.9,
            "minSupportCases": 5
          },
          "type": "object",
          "properties": {
            "minFitness": {
              "default": 0.9,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minSupportCases": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "minFitness",
            "minSupportCases"
          ],
          "additionalProperties": false
        },
        "backlog": {
          "default": {
            "minSupportCases": 10
          },
          "type": "object",
          "properties": {
            "minSupportCases": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "minSupportCases"
          ],
          "additionalProperties": false
        },
        "trend": {
          "default": {
            "minRelativeIncrease": 0.2,
            "minCasesPerWindow": 20
          },
          "type": "object",
          "properties": {
            "minRelativeIncrease": {
              "default": 0.2,
              "type": "number",
              "minimum": 0
            },
            "minCasesPerWindow": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "minRelativeIncrease",
            "minCasesPerWindow"
          ],
          "additionalProperties": false
        },
        "smallSampleCases": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "bottleneck",
        "rework",
        "rules",
        "conformance",
        "backlog",
        "trend",
        "smallSampleCases"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "projectId",
    "analysisRunId",
    "eventsKey",
    "artifactPrefix",
    "filter",
    "boundary",
    "rework",
    "rules",
    "bpmn",
    "bpmnUnavailableReason",
    "config"
  ],
  "additionalProperties": false
}

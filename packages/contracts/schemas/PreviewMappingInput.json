{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "stagingKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "config": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "object",
          "properties": {
            "caseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "activity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "timestamp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "startTimestamp": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "resource": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "eventId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "lifecycle": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "caseAttributes": {
              "default": [],
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "eventAttributes": {
              "default": [],
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "objectRefs": {
              "default": [],
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "required": [
            "caseId",
            "activity",
            "timestamp",
            "caseAttributes",
            "eventAttributes",
            "objectRefs"
          ],
          "additionalProperties": false
        },
        "timestampFormat": {
          "default": "auto",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "discriminator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "labelMap": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "requireLabelMap": {
          "default": false,
          "type": "boolean"
        },
        "repairRules": {
          "default": [],
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "exclude_invalid"
              },
              "checks": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "required_missing",
                    "timestamp_invalid",
                    "start_after_completion"
                  ]
                }
              }
            },
            "required": [
              "type",
              "checks"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "columns",
        "timestampFormat",
        "timezone",
        "labelMap",
        "requireLabelMap",
        "repairRules"
      ],
      "additionalProperties": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "projectId",
    "stagingKey",
    "config",
    "limit"
  ],
  "additionalProperties": false
}

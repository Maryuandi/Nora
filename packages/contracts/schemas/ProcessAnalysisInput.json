{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "analysisRunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "eventsKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "artifactPrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "filter": {
      "type": "object",
      "properties": {
        "version": {
          "default": 1,
          "type": "number",
          "const": 1
        },
        "period": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "from": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "attribute": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "values": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              },
              "required": [
                "key",
                "values"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "activityPresent": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "activityAbsent": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "variants": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{16,64}$"
          }
        },
        "duration": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "minSeconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxSeconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "completion": {
          "default": "all",
          "type": "string",
          "enum": [
            "all",
            "complete",
            "incomplete"
          ]
        },
        "objectRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "activityPresent",
        "activityAbsent",
        "variants",
        "completion"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "startActivities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "endActivities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "startActivities",
            "endActivities"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "caseAttributeKeys": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "projectId",
    "analysisRunId",
    "eventsKey",
    "artifactPrefix",
    "filter",
    "boundary",
    "caseAttributeKeys"
  ],
  "additionalProperties": false
}
